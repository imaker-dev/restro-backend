# Restro POS — Free Offline Version Configuration
# This file is auto-loaded by the free version entry point

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database — connects to local portable MariaDB
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=restro
DB_USER=restro
DB_PASSWORD=restro_pos_2024
DB_CONNECTION_LIMIT=10

# Production DB aliases — database.config.js uses PROD_DB_* when NODE_ENV=production
PROD_DB_HOST=127.0.0.1
PROD_DB_NAME=restro
PROD_DB_USER=restro
PROD_DB_PASSWORD=restro_pos_2024

# JWT
JWT_SECRET=restro-free-offline-jwt-secret-key-2024
JWT_EXPIRES_IN=30d

# Redis — disabled for free version
REDIS_ENABLED=false

# Sentry — disabled for free version
SENTRY_ENABLED=false
SENTRY_DSN=

# Queue — inline mode (no Redis/BullMQ)
QUEUE_MODE=inline

# Cron Jobs
ENABLE_CRON_JOBS=true

# Upload path (relative to executable)
UPLOAD_PATH=./uploads

# Free version marker
IS_FREE_VERSION=true
FREE_VERSION_ID=free-offline-v1

# Activation — system is locked until activated with a valid token
ACTIVATION_REQUIRED=true
